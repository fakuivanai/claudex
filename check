#!/bin/sh
set -eu

cd "$(dirname "$0")"
if [ -n "${CLAUDEX_PYTHON:-}" ]; then
    claudex_python=$CLAUDEX_PYTHON
else
    uv sync --frozen
    claudex_python=${UV_PROJECT_ENVIRONMENT:-.venv}/bin/python
fi
claudex_node=${CLAUDEX_NODE:-node}
"$claudex_python" -m mypy .
"$claudex_python" -B -m unittest discover -v
"$claudex_node" --test --test-isolation=none --test-timeout=10000 patcher/*.test.cjs
